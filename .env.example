# ============================================================================
# CRM SaaS — environment variables
# Copy this file to .env for local dev. On Railway, set these under each
# service's Variables tab. See DEPLOY.md for where to get every key.
# ============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/crm
REDIS_URL=redis://localhost:6379

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# AES-256-GCM key used to encrypt integration credentials at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars

# Comma-separated list of emails allowed into the cross-tenant /admin panel
# (see all organizations/customers, plans, usage). Anyone NOT in this list
# — including every regular customer — never sees /admin at all. Use the
# email of the account YOU log in with as the platform owner.
PLATFORM_ADMIN_EMAILS=you@example.com

# --- WhatsApp Cloud API (Meta) -----------------------------------------------
# These two belong to YOUR ONE Meta App (the platform/tech-provider app) — every
# customer's WhatsApp number sends webhook events through this same app, so
# there's one app secret / verify token for the whole deployment, not one per
# customer. From Meta for Developers > your App > App Settings > Basic (secret)
# and WhatsApp > Configuration (webhook verify token, your own choice of string).
# Each customer's own Phone Number ID / WABA ID / Access Token is entered by
# them on the Integrations page in the app (stored encrypted per-org in the
# database) — NOT set here.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_APP_SECRET=

# --- Meta Ads / Lead Ads (Marketing API) -------------------------------------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=choose-a-random-string

# --- Google Ads + Google Sheets ----------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-ads/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Shopify ------------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_customers
SHOPIFY_APP_URL=http://localhost:3000

# --- Razorpay (billing) --------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
